NODE_ENV=development
PORT=3000

JWT_SECRET=replace-with-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Supabase (recommended) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=menu-images

SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional Redis cache (falls back to in-memory if unset)
# REDIS_URL=redis://localhost:6379
CACHE_MENU_TTL=300

# --- Local MySQL (only if DATABASE_URL is empty) ---
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ecommerce
# DB_PORT=3306

DB_CONNECTION_LIMIT=10
DB_SSL=true

CORS_ORIGIN=*
RATE_LIMIT_MAX=300
PUBLIC_RATE_LIMIT_MAX=120
ENFORCE_HTTPS=false
LOG_TO_DB=true

API_KEY_HEADER=x-api-key
TENANT_HEADER=x-website-id

IMAGE_MAX_WIDTH=1920
IMAGE_QUALITY=82
